{
  "expo": {
    "name": "TrueSignal",
    "slug": "truesignal",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "truesignal",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.truesignal.app"
    },
    "android": {
      "package": "com.truesignal.app"
    }
  }
}
